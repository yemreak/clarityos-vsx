# VS Code workspace
.vscode/**

# Git
.git*

# macOS
.DS_Store

# Source files (compiled files in out/ are sufficient)
**/*.ts
!**/*.d.ts

# Build config
tsconfig.json
bun.lock

# Developer documentation (not needed by users)
ARCHITECTURE.md
CLAUDE.md

# Old packages
*.vsix

# Node modules (bundled with esbuild)
node_modules/**

# Exception: tsx (required for runtime TypeScript execution)
!node_modules/tsx/**
!node_modules/get-tsconfig/**
!node_modules/resolve-pkg-maps/**

# Source maps
**/*.map
